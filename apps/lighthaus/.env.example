# IAM api (auth: authorize, token, /me + refresh)
NEXT_PUBLIC_API_URL=https://api.sitehaus.dev
# IAM portal (email-verify redirect)
NEXT_PUBLIC_IAM_URL=https://iam.sitehaus.dev
# OAuth client key registered for the status app (status.sitehaus.dev)
NEXT_PUBLIC_CLIENT_KEY=

# lighthaus-api base URL (scoped /status read API)
NEXT_PUBLIC_LIGHTHAUS_API_URL=https://lighthaus-api.sitehaus.dev

# Optional build/version stamp surfaced by /api/health
APP_VERSION=dev
