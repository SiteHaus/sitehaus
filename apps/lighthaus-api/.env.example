# ── lighthaus-api ────────────────────────────────────────────────────────────
# Standalone monitoring backend. Runs checks, opens/resolves incidents, sends
# ops alerts, publishes the R2 status snapshot, and serves the scoped /status
# read API to the status UI. Deploys as its own Docker service on :3007.

# Postgres — SAME database as the IAM api (shares the monitoring + iam tables).
DATABASE_URL=postgresql://DBUSER:DBPASSWORD@HOST:PORT/DBNAME

# Redis — BullMQ queue for the email notifications the dispatcher enqueues.
REDIS_URL=redis://redis:6379

# JWT — MUST match apps/api so IAM-minted access tokens validate here.
# Prefer the base64url form if apps/api uses it; otherwise set JWT_SECRET.
JWT_SECRET=SUPERSECRETKEY
# JWT_SECRET_B64URL=

# Email (Resend) — incident / recovery / daily digest alerts to ops.
RESEND_API_KEY=RESEND_KEY
EMAIL_FROM="Lighthaus <alerts@sitehaus.dev>"
# Comma-separated ops recipients for all lighthaus alert emails.
OPS_RECIPIENTS=ops@sitehaus.dev

# Deadman / self-monitoring — lighthaus pings this Healthchecks.io URL each fast
# cycle so an outage of lighthaus itself is detected externally. Optional.
HEALTHCHECKS_URL=

# Shared secret for the /heartbeat ingest endpoint. Heartbeat pushers (e.g. the
# commerce worker) send it as `Authorization: Bearer <secret>`. Unset → the
# ingest endpoint fails closed (503).
HEARTBEAT_SECRET=

# Public URL of the status UI — used in ops email CTAs.
LIGHTHAUS_URL=https://status.sitehaus.dev
# Port the service listens on (compose maps 3007:3007).
LIGHTHAUS_PORT=3007
# Allowed CORS origin for the status UI (browser calls /status from here).
LIGHTHAUS_UI_ORIGIN=https://status.sitehaus.dev

# Cloudflare R2 — where the failure-domain-independent status.json is published.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_STATUS_BUCKET=lighthaus-status
# Public base URL the snapshot page reads status.json from.
R2_STATUS_PUBLIC_URL=https://status-data.sitehaus.dev

# First-party client id used to scope the OneHealth (client-site) monitors.
# Confirm the real client id at deploy time.
ONEHEALTH_CLIENT_ID=

# Optional build/version stamp surfaced by /health.
APP_VERSION=dev
