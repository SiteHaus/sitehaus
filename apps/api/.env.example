DATABASE_URL=postgresql://DBUSER:DBPASSWORD@HOST:PORT/DBNAME
JWT_SECRET=SUPERSECRETKEY

EMAIL_FROM="FIRST LAST <NAME@DOMAIN.TLD>"
EMAIL_REPLY_TO=support@sitehaus.dev

RESEND_API_KEY=RESEND_KEY
EMAIL_ENABLED=true

# OAuth Configuration
IAM_APP_URL=http://localhost:3002

# Cookie Configuration (for cross-subdomain auth)
# Set to .yourdomain.com in production for cookies to work across subdomains
COOKIE_DOMAIN=

# Cloudflare R2 Storage (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sitehaus-assets
MAX_UPLOAD_SIZE=52428800

# Redis (BullMQ + caching + rate limiting)
REDIS_URL=redis://localhost:6379

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Dashboard URL — used for email CTAs and Stripe portal return URL
# Local: http://localhost:3001 | Production: https://dashboard.sitehaus.dev
DASHBOARD_URL=http://localhost:3001

# Lighthaus ops notifications — the notifications processor routes lighthaus.*
# incident/recovery/digest jobs to these recipients. Comma-separated emails.
OPS_RECIPIENTS=ops@sitehaus.dev
# Status app URL used for the "view status" CTA in ops emails.
LIGHTHAUS_URL=https://status.sitehaus.dev

# Shared secret for service-to-service calls from sitehaus-commerce (billing lookups).
# Must be at least 16 characters — ServiceKeyGuard refuses every internal request
# when it's empty or shorter than that, rather than failing open. Generate with:
#   openssl rand -hex 32
COMMERCE_SERVICE_KEY=