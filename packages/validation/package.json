{
  "name": "@site-haus/validation",
  "type": "module",
  "private": true,
  "exports": {
    "./core/*": {
      "types": "./dist/core/*.d.ts",
      "default": "./dist/core/*.js"
    },
    "./forms/*": {
      "types": "./dist/forms/*.d.ts",
      "default": "./dist/forms/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsc -w",
    "build": "tsc"
  },
  "dependencies": {
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@site-haus/eslint-config": "workspace:*",
    "@site-haus/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "eslint": "^9.31.0",
    "typescript": "5.8.2"
  }
}
