{
  "name": "@sitehaus/client-sdk",
  "version": "0.4.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/SiteHaus/sitehaus"
  },
  "type": "module",
  "private": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsc -w",
    "build": "tsup"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./nestjs": {
      "types": "./dist/nestjs/index.d.ts",
      "default": "./dist/nestjs/index.js"
    },
    "./frontend": {
      "types": "./dist/frontend/index.d.ts",
      "default": "./dist/frontend/index.js"
    }
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@site-haus/contracts": "workspace:*",
    "@site-haus/eslint-config": "workspace:*",
    "@site-haus/sdk": "workspace:*",
    "@site-haus/stores": "workspace:*",
    "@site-haus/typescript-config": "workspace:*",
    "eslint": "^9.31.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "tsup": "^8.5.1",
    "typescript": "5.8.2"
  }
}
