POSTGRES_USER=sitehaus
POSTGRES_PASSWORD=supersecretpassword
POSTGRES_DB=sitehaus_db
DATABASE_URL=postgresql://sitehaus:supersecretpassword@db:5432/sitehaus_db

CADDY_EMAIL=email@domain.com

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=SiteHaus <noreply@notify.sitehaus.dev>
EMAIL_ENABLED=true

COOKIE_DOMAIN=.sitehaus.dev
COOKIE_SAME_SITE=none

# Lighthaus (monitoring). The lighthaus-api service reads its own
# apps/lighthaus-api/.env — see apps/lighthaus-api/.env.example. It must share
# DATABASE_URL, REDIS_URL, and the JWT secret with the IAM api. These two are
# also referenced by other services and belong in the shared stack env:
# Ops alert recipients (also consumed by the IAM api notifications processor).
OPS_RECIPIENTS=ops@sitehaus.dev
# Shared bearer secret for the lighthaus /heartbeat ingest endpoint. Heartbeat
# pushers (e.g. the commerce worker) send it as `Authorization: Bearer <secret>`.
HEARTBEAT_SECRET=