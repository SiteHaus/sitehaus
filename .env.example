POSTGRES_USER=sitehaus
POSTGRES_PASSWORD=supersecretpassword
POSTGRES_DB=sitehaus_db
DATABASE_URL=postgresql://sitehaus:supersecretpassword@db:5432/sitehaus_db

CADDY_EMAIL=email@domain.com

# Resend (used by both api and web apps)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# api only
EMAIL_FROM=SiteHaus <noreply@notify.sitehaus.dev>
EMAIL_ENABLED=true

# Cookie Configuration
COOKIE_DOMAIN=.sitehaus.dev
COOKIE_SAME_SITE=none  # Options: 'strict', 'lax', 'none'. Use 'none' for cross-origin setups